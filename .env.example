# Optional build-time overrides. Nothing is required: configuration lives in wrangler.jsonc.
# Values here are compiled into the browser bundle: never put secrets here.

# Override the Formspree form ID from wrangler.jsonc. Set to empty to build in
# demonstration mode (the contact form validates but sends nothing).
# VITE_FORMSPREE_FORM_ID=

# Plausible analytics domain, e.g. entometrics.com. Leave empty to disable analytics.
VITE_PLAUSIBLE_DOMAIN=
