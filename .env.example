# Client-side (build-time) variables. Copy to .env and fill in only when ready.
# These are embedded in the browser bundle: never put secrets here.

# Cloudflare Turnstile site key (public). Leave empty to disable the widget.
VITE_TURNSTILE_SITE_KEY=

# Plausible analytics domain, e.g. entometrics.org. Leave empty to disable analytics.
VITE_PLAUSIBLE_DOMAIN=
