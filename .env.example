# Build-time (client) variables. Copy to .env and fill in.
# These are compiled into the browser bundle: never put secrets here.

# Formspree form ID for the contact form, the part after https://formspree.io/f/
# (e.g. xyzabcde). Leave empty to keep the form in demonstration mode (nothing is sent).
VITE_FORMSPREE_FORM_ID=

# Plausible analytics domain, e.g. entometrics.com. Leave empty to disable analytics.
VITE_PLAUSIBLE_DOMAIN=
