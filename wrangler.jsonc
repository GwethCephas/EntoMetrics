{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "entometrics-africa",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // Custom domains: Cloudflare creates the DNS records and certificates on deploy.
  // www is redirected to the bare domain in workers/app.ts.
  "routes": [
    { "pattern": "entometrics.com", "custom_domain": true },
    { "pattern": "www.entometrics.com", "custom_domain": true }
  ],
  // Non-secret runtime configuration (the dashboard is overwritten on every deploy).
  // The contact form's Formspree ID is a build-time variable (VITE_FORMSPREE_FORM_ID).
  "vars": {
    "SITE_URL": "https://entometrics.com"
  }
}
