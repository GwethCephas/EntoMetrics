{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "entometrics-africa",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // Custom domains: Cloudflare creates the DNS records and certificates on deploy.
  // www is redirected to the bare domain in workers/app.ts.
  "routes": [
    { "pattern": "entometrics.com", "custom_domain": true },
    { "pattern": "www.entometrics.com", "custom_domain": true }
  ],
  // Non-secret configuration; this file is the source of truth (the dashboard is
  // overwritten on every deploy). VITE_FORMSPREE_FORM_ID is also read at build time
  // by vite.config.ts, so the contact form needs no separate build variable.
  "vars": {
    "SITE_URL": "https://entometrics.com",
    "VITE_FORMSPREE_FORM_ID": "mqpergba"
  }
}
